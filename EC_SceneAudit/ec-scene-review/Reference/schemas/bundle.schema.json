{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ec-scene-audit.invalid/schema/bundle.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "ec-scene-review-bundle"
    },
    "version": {
      "const": 1
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "exportedAt": {
          "type": "string",
          "minLength": 1
        },
        "gameVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugins": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "exportedAt"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "scene",
              "summary",
              "dependency"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "capturedAt": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "type": [
              "string",
              "null"
            ]
          },
          "parseStatus": {
            "enum": [
              "valid",
              "invalid",
              "unreadable"
            ]
          }
        },
        "required": [
          "fileId",
          "role",
          "path",
          "sha256",
          "byteLength"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "dependency"
                }
              }
            },
            "then": {
              "required": [
                "sourcePath",
                "capturedAt",
                "encoding",
                "parseStatus"
              ]
            }
          }
        ]
      },
      "minItems": 2
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "https://ec-scene-audit.invalid/schema/common.json#/definitions/reference"
          },
          "requestedPath": {
            "type": "string"
          },
          "targetFileId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "included",
              "missing",
              "dynamic",
              "outside-userdata",
              "link",
              "invalid-path",
              "unreadable",
              "limit",
              "unstable"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "from",
          "requestedPath",
          "targetFileId",
          "status",
          "reason",
          "context"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "https://ec-scene-audit.invalid/schema/common.json#/definitions/reference"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "source",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "bundleId",
    "scene",
    "files",
    "dependencies",
    "limitations"
  ],
  "additionalProperties": false
}
