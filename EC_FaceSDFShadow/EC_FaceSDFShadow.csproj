<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net46</TargetFramework>
        <AssemblyName>EC_FaceSDFShadow</AssemblyName>
        <OutputType>Library</OutputType>
        <RootNamespace>EC_FaceSDFShadow</RootNamespace>
        <LangVersion>9.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputPath>../../bin/BepInEx/plugins/EC_FaceSDFShadow/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <!-- UnityProject 是给 Unity 编辑器用的，不参与 dotnet 编译 -->
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="Properties/*.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- shader bundle 打进 DLL；缺失时构建仍通过，运行时报错提示去构建 -->
        <EmbeddedResource Include="Resources/ec_facesdf.unity3d" Condition="Exists('Resources/ec_facesdf.unity3d')" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="IllusionLibs.BepInEx" Version="5.4.22" />
        <PackageReference Include="IllusionLibs.EmotionCreators.Assembly-CSharp" Version="2019.6.6.4" />
        <PackageReference Include="IllusionLibs.EmotionCreators.UnityEngine.CoreModule" Version="2017.4.24.4" />
        <!-- ShadowColorMixer 的 IMGUI 控件（GUI/GUILayout/Event）在 Unity 2017 属于独立模块 -->
        <PackageReference Include="IllusionLibs.EmotionCreators.UnityEngine.IMGUIModule" Version="2017.4.24.4" />
        <!-- Texture2D.LoadImage / EncodeToPNG 在 Unity 2017 属于独立模块 -->
        <PackageReference Include="IllusionLibs.EmotionCreators.UnityEngine.ImageConversionModule" Version="2017.4.24.4" />
        <PackageReference Include="IllusionLibs.EmotionCreators.IL" Version="2019.6.6.4" />
    </ItemGroup>
    <ItemGroup>
        <!-- 角色卡扩展数据依赖：ESF + ECAPI -->
        <Reference Include="EC_ExtensibleSaveFormat">
            <HintPath>../../Reference/ReferencePlugins/EC_ExtensibleSaveFormat.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ECAPI">
            <HintPath>../../Reference/ReferencePlugins/ECAPI.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <Target Name="SkipAllRefs" AfterTargets="ResolveReferences">
        <ItemGroup>
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
        </ItemGroup>
    </Target>

    <!-- Unity 构建产物 → Resources/(被嵌进 DLL 的那份)。
         Inputs/Outputs 使其只在产物更新时才拷,不会用旧 bundle 覆盖新的。
         没有这一步时的故障形态:改了 shader、Unity 也重新打了包,但 DLL 里嵌的还是
         上一版 —— 运行期只表现为"某个 shader 加载不到、对应功能静默降级",
         查代码永远查不出来(2026-08-28 实测:17_HairFadeBand 因此白查一轮)。 -->
    <Target Name="SyncShaderBundle" BeforeTargets="BeforeBuild;PrepareForBuild"
            Inputs="UnityProject/AssetBundles/ec_facesdf.unity3d"
            Outputs="Resources/ec_facesdf.unity3d"
            Condition="Exists('UnityProject/AssetBundles/ec_facesdf.unity3d')">
        <Message Importance="high"
                 Text="[FaceSDF] shader bundle 有更新,同步到 Resources/ 后再嵌入" />
        <Copy SourceFiles="UnityProject/AssetBundles/ec_facesdf.unity3d"
              DestinationFiles="Resources/ec_facesdf.unity3d" />
    </Target>

    <!-- shader 源码比 bundle 新 = 改了 shader 但没在 Unity 里重打包。
         dotnet build 无法代打(要 Unity 编辑器),所以只能告警,不能自动修。
         逐文件显式比时间戳(不用 Inputs/Outputs 的隐式增量:多输入单输出的比较语义
         容易误报,调不动)。批处理 %(_ShaderSrc...) 使告警能点名具体哪个 shader 旧了。 -->
    <Target Name="WarnStaleShaderBundle" AfterTargets="SyncShaderBundle"
            Condition="Exists('UnityProject/AssetBundles/ec_facesdf.unity3d')">
        <ItemGroup>
            <_ShaderSrc Include="UnityProject/Assets/Shaders/*.shader" />
            <_BundleF Include="UnityProject/AssetBundles/ec_facesdf.unity3d" />
        </ItemGroup>
        <PropertyGroup>
            <!-- 先 transform 成普通字符串,再 Parse:%() 直接写在 PropertyGroup 里会
                 让整个 PropertyGroup 进入批处理语义,不可控 -->
            <_BundleMod>@(_BundleF->'%(ModifiedTime)')</_BundleMod>
            <_BundleTicks>$([System.DateTime]::Parse('$(_BundleMod)').Ticks)</_BundleTicks>
        </PropertyGroup>
        <Warning Condition="$([System.DateTime]::Parse('%(_ShaderSrc.ModifiedTime)').Ticks) &gt; $(_BundleTicks)"
                 Text="[FaceSDF] %(_ShaderSrc.Filename)%(_ShaderSrc.Extension) 比 bundle 新:请先在 Unity 里重建 bundle(BuildBundle.cs),否则本次构建嵌入的是旧 shader。" />
    </Target>
</Project>
